flowchart TD
    Q(["Query string<br/>(from agent or user)"])

    subgraph Retrieval["1. Parallel retrieval"]
        direction TB

        SPLIT{{"Split query<br/>to retrievers"}}

        subgraph RetrieverPair["Dense + lexical retrieval"]
            direction LR
            DENSE["Dense retrieval<br/>bi-encoder + numpy dot product<br/>over (n_chunks, 384) index"]
            BM25["BM25 retrieval<br/>rank-bm25 over tokenized corpus<br/>k1 = 1.5, b = 0.75"]
        end

        subgraph TopCandidates["Initial candidates"]
            direction LR
            DTOP["Dense top-30<br/>by cosine similarity"]
            BTOP["BM25 top-30<br/>by BM25 score"]
        end

        SPLIT --> DENSE
        SPLIT --> BM25
        DENSE --> DTOP
        BM25 --> BTOP
    end

    subgraph Fusion["2. Rank fusion"]
        direction TB
        RRF["Reciprocal Rank Fusion<br/>score = sum 1 / (60 + rank)<br/>across both retrievers"]
        FUSED["Unified top-30 candidates<br/>score scales unified by rank fusion"]
        RRF --> FUSED
    end

    subgraph Diversification["3. Optional diversification"]
        direction TB
        MMRCHECK{"Diversify results?"}
        MMR["MMR rerank<br/>lambda = 0.7 default<br/>maximize relevance while reducing redundancy"]
        RERANK_IN["Top-30 candidates<br/>diversified only when MMR is enabled"]

        MMRCHECK -->|"use_mmr = true<br/>redundancy-prone query"| MMR
        MMRCHECK -->|"use_mmr = false<br/>default path"| RERANK_IN
        MMR --> RERANK_IN
    end

    subgraph Reranking["4. Cross-encoder reranking"]
        direction TB
        RERANK["Cross-encoder rerank<br/>ms-marco-MiniLM-L-6-v2<br/>about 30 query-chunk pairs<br/>output: raw logits"]
        FLOOR{"Any score above<br/>MIN_SIMILARITY?"}
        EMPTY(["status: empty<br/>no chunks crossed<br/>rerank floor"])
        TOPK["Select top-k<br/>by rerank score<br/>default k = 5"]

        RERANK --> FLOOR
        FLOOR -->|"no"| EMPTY
        FLOOR -->|"yes"| TOPK
    end

    subgraph Output["5. Output envelope"]
        direction TB
        ENVELOPE["Build result envelope<br/>chunk_id, doc_id, title,<br/>snippet, score,<br/>retrieval_signals"]
        OUT(["status: ok<br/>results: chunk envelopes<br/>same contract as Lab 06"])

        TOPK --> ENVELOPE
        ENVELOPE --> OUT
    end

    subgraph Latency["Latency notes<br/>(CPU laptop)"]
        direction TB
        L1["Dense: about 10-50 ms"]
        L2["BM25: about 1-5 ms"]
        L3["RRF: about 1 ms"]
        L4["MMR: about 5-20 ms"]
        L5["Cross-encoder: about 300-1500 ms<br/>dominant cost"]
    end

    Q --> SPLIT

    DTOP --> RRF
    BTOP --> RRF

    FUSED --> MMRCHECK
    RERANK_IN --> RERANK

    Reranking -.-> Latency

    classDef retriever fill:#dfd,stroke:#080,stroke-width:1px,color:#064e3b;
    classDef fusion fill:#cef,stroke:#247,stroke-width:1px,color:#12355b;
    classDef rerank fill:#fcf,stroke:#739,stroke-width:1px,color:#4a044e;
    classDef decision fill:#ffd,stroke:#a80,stroke-width:1px,color:#713f12;
    classDef terminal fill:#eee,stroke:#666,stroke-width:1px,color:#111827;
    classDef escape fill:#fed,stroke:#a40,stroke-width:1px,color:#7c2d12;
    classDef split fill:#fff,stroke:#888,stroke-width:1px,color:#111827;
    classDef note fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#334155;

    class DENSE,BM25,DTOP,BTOP retriever;
    class RRF,FUSED,MMR,RERANK_IN fusion;
    class RERANK,TOPK,ENVELOPE rerank;
    class MMRCHECK,FLOOR decision;
    class Q,OUT terminal;
    class EMPTY escape;
    class SPLIT split;
    class L1,L2,L3,L4,L5 note;
