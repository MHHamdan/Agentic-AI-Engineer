flowchart LR
    U(["User query"])
    Final(["Final answer<br/>with [chunk_id] citations"])

    subgraph Supervisor["Supervisor agent"]
        direction TB
        S1["Read corpus description<br/>+ 4 retrieval-decision rules"]
        S2["Decide: retrieve or skip?"]
        S3["Route to worker<br/>(or finalize directly)"]
        S1 --> S2
        S2 --> S3
    end

    subgraph Retriever["Retriever worker<br/>(wraps Lab 06-08 pipeline)"]
        direction TB
        R1["Dense embed query<br/>(MiniLM)"]
        R2["BM25 lexical search"]
        R3["RRF merge<br/>(k=60)"]
        R4["Cross-encoder rerank<br/>(ms-marco-MiniLM)"]
        R5["Apply relevance floor<br/>(MIN_RERANK_SCORE = -2.0)"]
        R1 --> R3
        R2 --> R3
        R3 --> R4
        R4 --> R5
    end

    Envelope(["Chunks envelope<br/>{status, chunks: [{id, text, source, title, score}], pipeline}"])

    subgraph Synthesizer["Synthesizer worker"]
        direction TB
        SY1["Read chunks verbatim<br/>(no paraphrase, no filter)"]
        SY2["Compose answer with<br/>inline [chunk_id] citations"]
        SY3["Render citation list:<br/>[chunk_id] source - title"]
        SY1 --> SY2
        SY2 --> SY3
    end

    subgraph CriticOpt["Critic (Lab 11, optional stretch)"]
        direction TB
        C1["Check every claim<br/>against chunks"]
        C2["Flag: unsupported,<br/>wrong attribution,<br/>missing citation"]
        C1 --> C2
    end

    U -->|"query: str"| S1

    S3 ==>|"retrieve (corpus-grounded)"| R1
    S3 -.->|"skip (stable-knowledge)<br/>direct answer with disclaimer"| Final

    R5 ==>|"verbatim envelope"| Envelope
    Envelope ==>|"chunks passed VERBATIM<br/>by supervisor (no reformat)"| SY1
    SY3 ==>|"answer + citations"| Final

    SY3 -.->|"draft for review"| C1
    C2 -.->|"needs_revision<br/>(MAX_REFINEMENT_CYCLES = 3)"| SY1

    S3 -.->|"retrieval skip:<br/>confidently wrong answer<br/>on corpus-grounded query"| Final
    S3 -.->|"retrieval over-call:<br/>retrieves on stable-knowledge query<br/>(wasteful but not wrong)"| R1
    Envelope -.->|"citation drift:<br/>supervisor paraphrases or<br/>re-numbers chunks before<br/>passing them on"| SY1
    SY3 -.->|"chunk drift:<br/>synthesizer paraphrases<br/>beyond what chunks support<br/>(mitigated by Lab 11 critic)"| Final

    classDef user fill:#e8eaf6,stroke:#3949ab,stroke-width:2px,color:#1a237e;
    classDef supervisor fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#e65100;
    classDef retriever fill:#e0f2f1,stroke:#00695c,stroke-width:1px,color:#004d40;
    classDef synthesizer fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px,color:#4a148c;
    classDef critic fill:#e1bee7,stroke:#8e24aa,stroke-width:1px,color:#4a148c;
    classDef envelope fill:#fffde7,stroke:#f9a825,stroke-width:2px,color:#f57f17;
    classDef terminal fill:#f1f8e9,stroke:#558b2f,stroke-width:2px,color:#33691e;

    class U user;
    class S1,S2,S3 supervisor;
    class R1,R2,R3,R4,R5 retriever;
    class SY1,SY2,SY3 synthesizer;
    class C1,C2 critic;
    class Envelope envelope;
    class Final terminal;
