flowchart TD
    Q(["User question"])

    subgraph SearchStage["1. Search corpus"]
        direction TB
        SEARCH["search_corpus<br/>(snippets + scores)"]
        CHECK{"Results status?"}
        SEARCH --> CHECK
    end

    subgraph Refinement["2. Query refinement"]
        direction TB
        REFINE["Refine query<br/>(repeated-action detector<br/>blocks identical retry)"]
        RETRY{"Retry allowed?"}
        REFINE --> RETRY
    end

    subgraph EvidenceStage["3. Evidence selection and reading"]
        direction TB
        TRIAGE["Model picks<br/>1-2 candidate chunks"]
        READ["read_chunk<br/>(one chunk_id)"]
        RRESULT{"Read status?"}
        NEXT["Pick next<br/>candidate chunk"]
        MORE{"More candidates?"}
        GROUND["Track grounded evidence<br/>(chunk_id, doc_id, title)"]
        ENOUGH{"Enough evidence?"}

        TRIAGE --> READ
        READ --> RRESULT
        RRESULT -->|"ok"| GROUND
        RRESULT -->|"not_found"| NEXT
        NEXT --> MORE
        MORE -->|"yes"| READ
        GROUND --> ENOUGH
    end

    subgraph AnswerStage["4. Answer synthesis"]
        direction TB
        DIRECT["Synthesize<br/>from snippets"]
        CITELESS(["Answer<br/>without full-chunk citations"])
        SYNTH["Synthesize answer<br/>from read-confirmed evidence"]
        FINAL(["Answer +<br/>chunk-level citations"])

        DIRECT --> CITELESS
        SYNTH --> FINAL
    end

    subgraph EscapeStage["5. Graceful escape"]
        direction TB
        GRACEFUL["Graceful exit<br/>I could not find this in the corpus<br/>+ what was read"]
    end

    Q --> SEARCH

    CHECK -->|"empty<br/>no chunk above floor"| REFINE
    CHECK -->|"ok, but snippets<br/>look irrelevant"| REFINE
    CHECK -->|"ok, snippets<br/>answer directly"| DIRECT
    CHECK -->|"ok, relevant<br/>snippets"| TRIAGE

    RETRY -->|"yes"| SEARCH
    RETRY -->|"no"| GRACEFUL

    MORE -->|"no"| REFINE

    ENOUGH -->|"yes"| SYNTH
    ENOUGH -->|"no, need another doc"| REFINE
    ENOUGH -->|"no, same doc has more chunks"| TRIAGE

    GRACEFUL --> FINAL

    SEARCH -.->|"step cap"| GRACEFUL
    READ -.->|"step cap"| GRACEFUL

    classDef tool fill:#dfd,stroke:#080,stroke-width:1px,color:#064e3b;
    classDef decision fill:#ffd,stroke:#a80,stroke-width:1px,color:#713f12;
    classDef action fill:#def,stroke:#446,stroke-width:1px,color:#1e3a8a;
    classDef terminal fill:#eee,stroke:#666,stroke-width:1px,color:#111827;
    classDef escape fill:#fed,stroke:#a40,stroke-width:1px,stroke-dasharray:4 4,color:#7c2d12;
    classDef group fill:#fffef2,stroke:#d6d3a4,stroke-width:1px,color:#111827;

    class SEARCH,READ tool;
    class CHECK,RRESULT,ENOUGH,RETRY,MORE decision;
    class TRIAGE,GROUND,NEXT,REFINE,SYNTH,DIRECT action;
    class Q,FINAL,CITELESS terminal;
    class GRACEFUL escape;
    class SearchStage,Refinement,EvidenceStage,AnswerStage,EscapeStage group;
