# ─────────────────────────────────────────────────────────────────────────────
# Agentic AI Engineer — environment variable template
#
# Copy this file to .env and fill in the keys you have. Never commit .env.
#
# Most labs need ONE model provider key. Optional keys unlock specific labs
# (tracing, web search, vector DBs). Each lab's README lists the keys it uses.
# See setup/api-keys.md for sign-up links and rate-limit notes.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Model providers (pick at least one) ─────────────────────────────────────

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio / Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Google Vertex AI (alternative to AI Studio; requires GCP project)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1


# ─── Observability and evaluation ────────────────────────────────────────────

# LangSmith — https://smith.langchain.com/
# Enables tracing across labs that use LangChain / LangGraph.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-ai-engineer
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # change for self-hosted


# ─── Tools used by labs ──────────────────────────────────────────────────────

# Tavily web search — https://tavily.com/
# Used by RAG and research-agent labs that need a web tool.
TAVILY_API_KEY=

# Serper (Google search wrapper) — https://serper.dev/
# Alternative to Tavily. Set ONE, not both, per lab.
# SERPER_API_KEY=


# ─── Vector databases ────────────────────────────────────────────────────────

# Pinecone (hosted) — https://app.pinecone.io/
# PINECONE_API_KEY=
# PINECONE_INDEX=agentic-ai-engineer

# Qdrant (local docker or cloud) — https://qdrant.tech/
# Local default after `docker run -p 6333:6333 qdrant/qdrant`
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                 # only required for Qdrant Cloud

# Weaviate
# WEAVIATE_URL=
# WEAVIATE_API_KEY=

# pgvector (Postgres with the pgvector extension)
# POSTGRES_URL=postgresql://user:pass@localhost:5432/agentic_ai


# ─── Local model option (Ollama / vLLM) ──────────────────────────────────────

# If set, labs that support a local model toggle will use this instead of a
# paid provider. See setup/local-models.md for hardware notes.

# LOCAL_MODEL_PROVIDER=ollama          # ollama | vllm | openai-compatible
# LOCAL_MODEL_NAME=llama3.1:8b
# LOCAL_MODEL_BASE_URL=http://localhost:11434


# ─── MCP / A2A labs ──────────────────────────────────────────────────────────

# MCP labs run servers and clients locally — no API key required by default.
# Some MCP servers wrap external APIs; those keys go above (e.g. Tavily).

# A2A labs use HTTP between local agents — no API key required.


# ─── Misc ────────────────────────────────────────────────────────────────────

# If you're running labs from a notebook in a directory the lab doesn't expect,
# set this to the repo root and the labs' setup cells will respect it.
# AGENTIC_REPO_ROOT=

# Set to "true" to enable verbose debug logging across labs.
DEBUG=false
